# ─────────────────────────────────────────────────────────────────────────────
# Sankalp PMC — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these in your Vercel Project Settings for production deployment.
# ─────────────────────────────────────────────────────────────────────────────

# Delivery Recipient Email (defaults to siteConfig.email: careers@sankalppmc.com)
EMAIL_TO=careers@sankalppmc.com

# From Address header for outgoing inquiry notifications
EMAIL_FROM="Sankalp PMC Website" <noreply@sankalppmc.com>

# SMTP Configuration (Works with Gmail, Resend SMTP, Sendgrid, Zoho, Amazon SES, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# Base URL for canonical links and metadata
NEXT_PUBLIC_SITE_URL=https://sankalppmc.com
