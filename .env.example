# ─────────────────────────────────────────────────────────────────────────────
# Sankalp PMC — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these in your hosting environment (e.g. Vercel) for production.
# ─────────────────────────────────────────────────────────────────────────────

# Delivery Recipient Email
EMAIL_TO=careers@sankalppmc.com

# From Address header for outgoing inquiry notifications
EMAIL_FROM="Sankalp PMC Website" <noreply@sankalppmc.com>

# SMTP Configuration (Works with Resend SMTP, Sendgrid, Zoho, Amazon SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-username
SMTP_PASS=smtp-password-placeholder

# Base URL / Allowed Origins for CSRF verification
NEXT_PUBLIC_SITE_URL=https://sankalppmc.com
SITE_ORIGIN=https://sankalppmc.com

# Optional: Upstash Redis for distributed rate-limiting across serverless instances
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
